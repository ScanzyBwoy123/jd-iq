{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/ScanzyBwoy123/jd-iq/blob/main/schema/investigation.schema.json",
  "title": "JD IQ Investigation Registry",
  "type": "object",
  "required": [
    "registry_name",
    "registry_version",
    "programme",
    "record_policy",
    "records"
  ],
  "properties": {
    "registry_name": {
      "const": "JD IQ Scientific Investigation Registry"
    },
    "registry_version": {
      "type": "string"
    },
    "programme": {
      "type": "object",
      "required": [
        "approved_investigation_count",
        "expansion_closed_at"
      ],
      "properties": {
        "approved_investigation_count": {
          "const": 200
        },
        "expansion_closed_at": {
          "const": 200
        }
      },
      "additionalProperties": false
    },
    "record_policy": {
      "type": "string",
      "minLength": 1
    },
    "records": {
      "type": "array",
      "minItems": 200,
      "maxItems": 200,
      "items": {
        "type": "object",
        "required": [
          "number",
          "identifier",
          "title",
          "description",
          "record_status",
          "provenance",
          "notes"
        ],
        "properties": {
          "number": {
            "type": "integer",
            "minimum": 1,
            "maximum": 200
          },
          "identifier": {
            "type": [
              "string",
              "null"
            ]
          },
          "title": {
            "type": [
              "string",
              "null"
            ]
          },
          "description": {
            "type": [
              "string",
              "null"
            ]
          },
          "record_status": {
            "enum": [
              "needs_source_recovery",
              "partial_source_recovery_required",
              "source_recovered",
              "verified"
            ]
          },
          "provenance": {
            "type": "object",
            "required": [
              "source_type",
              "source_reference",
              "verified_against_original_record"
            ],
            "properties": {
              "source_type": {
                "type": "string"
              },
              "source_reference": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "verified_against_original_record": {
                "type": "boolean"
              }
            },
            "additionalProperties": false
          },
          "notes": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
